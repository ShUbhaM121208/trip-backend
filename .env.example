# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
# Local Development: Frontend running on Vite dev server
CORS_ORIGIN=http://localhost:8080

# Production: Add your deployed frontend URL in Vercel Environment Variables
# CORS_ORIGIN=https://your-frontend.vercel.app

# Application Configuration
APP_NAME=Trip Companion API
API_VERSION=v1

# ==============================================
# VERCEL DEPLOYMENT NOTES:
# ==============================================
# 1. Vercel automatically sets NODE_ENV=production
# 2. PORT is managed by Vercel (no need to set)
# 3. Set CORS_ORIGIN in Vercel dashboard to your frontend URL
# 4. Other variables can use defaults or be set as needed
